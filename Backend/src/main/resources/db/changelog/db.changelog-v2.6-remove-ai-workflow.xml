<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.17.xsd">

    <changeSet id="v2.6-1-normalize-support-session-statuses" author="modoria">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="support_sessions"/>
            <columnExists tableName="support_sessions" columnName="status"/>
        </preConditions>

        <sql>UPDATE support_sessions SET status = 'OPEN' WHERE status = 'BOT_HANDLING'</sql>
        <sql>UPDATE support_sessions SET status = 'IN_PROGRESS' WHERE status = 'ACTIVE_AGENT'</sql>
    </changeSet>

</databaseChangeLog>