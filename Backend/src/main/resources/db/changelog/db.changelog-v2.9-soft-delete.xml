<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.17.xsd">

    <changeSet id="v2.9-1-soft-delete-flags" author="modoria">
        <addColumn tableName="users">
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <addColumn tableName="categories">
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <addColumn tableName="products">
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="v2.9-2-soft-delete-indexes" author="modoria">
        <createIndex tableName="users" indexName="idx_users_deleted">
            <column name="deleted"/>
        </createIndex>

        <createIndex tableName="categories" indexName="idx_categories_deleted">
            <column name="deleted"/>
        </createIndex>

        <createIndex tableName="products" indexName="idx_products_deleted">
            <column name="deleted"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
